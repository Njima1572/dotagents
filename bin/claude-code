#!/bin/bash
set -euo pipefail

current_dir=$PWD

GIT_REPO_ROOT=/home/kn/Development/claude-code
cd $GIT_REPO_ROOT
script_dir=$(dirname "$(readlink -f "$0")")
source "$script_dir/volumes.sh"

echo $DOCKER_VOLUMES

docker compose run -it $DOCKER_VOLUMES -w $current_dir --rm claude-code claude $@

cleanup() {
  cd $current_dir
}
trap cleanup EXIT SIGINT SIGTERM SIGKILL
