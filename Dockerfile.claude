FROM node:22

# ── Configuration ────────────────────────────────────────────────
ARG TZ
ENV TZ="$TZ"
ARG CLAUDE_CODE_VERSION="latest"
ARG USERNAME=node
ARG GITLAB_CLI_VERSION="1.82.0"
ARG GO_VERSION="1.26.0"
ENV USER_HOME=/home/${USERNAME}

# ── Feature flags (all enabled by default) ───────────────────────
ARG ENABLE_CHROME=true
ARG ENABLE_GO=true
ARG ENABLE_ENTIRE=true
ARG ENABLE_AWS=true
ARG ENABLE_BUN=true
ARG ENABLE_PYTHON=true
ARG ENABLE_UV=true
ARG ENABLE_PYRIGHT=true
ARG ENABLE_AGENT_BROWSER=true


# Create user if it doesn't already exist (e.g. USERNAME != node)
RUN if ! id -u ${USERNAME} > /dev/null 2>&1; then \
  groupadd -r ${USERNAME} && \
  useradd -m -g ${USERNAME} -d ${USER_HOME} -s /bin/zsh ${USERNAME}; \
  fi

# Install base dev tools + conditionally add Chrome/Python apt packages
RUN CHROME_PKGS="" && \
  PYTHON_PKGS="" && \
  if [ "$ENABLE_CHROME" = "true" ]; then \
    CHROME_PKGS="libatk1.0-0 libatk-bridge2.0-0 libdbus-1-3 libcups2 libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libnss3 fonts-noto-core"; \
  fi && \
  if [ "$ENABLE_PYTHON" = "true" ]; then \
    PYTHON_PKGS="python3 python3-pip poppler-utils"; \
  fi && \
  apt update && apt install -y \
    $CHROME_PKGS \
    $PYTHON_PKGS \
    less \
    git \
    git-lfs \
    procps \
    sudo \
    fzf \
    zsh \
    man-db \
    unzip \
    gnupg \
    gh \
    iptables \
    ipset \
    iproute2 \
    dnsutils \
    aggregate \
    jq \
    ripgrep \
    openssh-client \
    ca-certificates \
    build-essential && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* && \
  echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Ensure default user has access to /usr/local/share
RUN mkdir -p /usr/local/share/npm-global && \
  chown -R ${USERNAME}:${USERNAME} /usr/local/share

# Persist bash history
RUN SNIPPET="export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
  && mkdir /commandhistory \
  && touch /commandhistory/.bash_history \
  && chown -R $USERNAME /commandhistory

# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

# Create workspace and config directories and set permissions
RUN mkdir -p ${USER_HOME}/.claude ${USER_HOME}/.pip-packages && \
  chown -R ${USERNAME}:${USERNAME} ${USER_HOME}/.claude ${USER_HOME}/.pip-packages

# Install git-delta
RUN ARCH=$(dpkg --print-architecture) && \
  wget "https://github.com/dandavison/delta/releases/download/0.18.2/git-delta_0.18.2_${ARCH}.deb" && \
  sudo dpkg -i "git-delta_0.18.2_${ARCH}.deb" && \
  rm "git-delta_0.18.2_${ARCH}.deb"

RUN corepack enable && corepack prepare pnpm@latest --activate

# Install Go
RUN if [ "$ENABLE_GO" = "true" ]; then \
  ARCH=$(dpkg --print-architecture) && \
  wget https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz && \
  tar -C /usr/local -xzf go${GO_VERSION}.linux-${ARCH}.tar.gz && \
  rm go${GO_VERSION}.linux-${ARCH}.tar.gz; \
  fi
ENV PATH=$PATH:/usr/local/go/bin

# Install AWS CLI v2
RUN if [ "$ENABLE_AWS" = "true" ]; then \
  ARCH=$(uname -m) && \
  curl "https://awscli.amazonaws.com/awscli-exe-linux-${ARCH}.zip" -o "awscliv2.zip" && \
  unzip awscliv2.zip && \
  ./aws/install && \
  rm -rf awscliv2.zip aws; \
  fi

# Set up non-root user
USER ${USERNAME}

# Install uv/uvx
RUN if [ "$ENABLE_UV" = "true" ]; then \
  curl -LsSf https://astral.sh/uv/install.sh | sh; \
  fi

# Install Claude CLI
RUN curl -fsSL https://claude.ai/install.sh | bash

# Add uv to PATH (installed to ~/.local/bin by default)
ENV PATH=${USER_HOME}/.local/bin:$PATH

# Install bun
RUN if [ "$ENABLE_BUN" = "true" ]; then \
  curl -fsSL https://bun.com/install | bash; \
  fi
ENV PATH=${USER_HOME}/.bun/bin:${USER_HOME}/go/bin:$PATH

# Install global packages
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=$PATH:/usr/local/share/npm-global/bin

# Configure pip to install packages to user directory
ENV PIP_TARGET=${USER_HOME}/.pip-packages
ENV PYTHONPATH=${USER_HOME}/.pip-packages
ENV PATH=$PATH:${USER_HOME}/.pip-packages/bin

# Set the default shell to zsh rather than sh
ENV SHELL=/bin/zsh

# Default powerline10k theme
RUN sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v1.2.0/zsh-in-docker.sh)" -- \
  -p git \
  -p fzf \
  -a "source /usr/share/doc/fzf/examples/key-bindings.zsh" \
  -a "source /usr/share/doc/fzf/examples/completion.zsh" \
  -a "export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
  -x

# Install pyright LSP
RUN if [ "$ENABLE_PYRIGHT" = "true" ]; then \
  npm install -g pyright; \
  fi

# Install entire CLI (requires Go)
RUN if [ "$ENABLE_ENTIRE" = "true" ] && [ "$ENABLE_GO" = "true" ]; then \
  go install github.com/entireio/cli/cmd/entire@latest; \
  fi

# Install agent-browser (requires Chrome dependencies)
RUN if [ "$ENABLE_AGENT_BROWSER" = "true" ] && [ "$ENABLE_CHROME" = "true" ]; then \
  npm install -g agent-browser && agent-browser install; \
  fi


# Install Python requirements
COPY ./requirements.txt /tmp/requirements.txt
RUN if [ "$ENABLE_PYTHON" = "true" ]; then \
  pip3 install --break-system-packages -r /tmp/requirements.txt; \
  fi

COPY ./.gitconfig ${USER_HOME}/.gitconfig

# Fix ownership of entire home directory (covers .claude, .config, .dotnet, .nuget, .pip-packages, etc.)
USER root
RUN chown -R ${USERNAME}:${USERNAME} ${USER_HOME}
USER ${USERNAME}
