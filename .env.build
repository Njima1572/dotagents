# Feature flags for Dockerfile.claude
# Set to "false" to disable a feature, "true" to enable
# Usage: ./bin/build (reads this file automatically)

ENABLE_CHROME=true
ENABLE_GO=false
ENABLE_ENTIRE=false
ENABLE_AWS=true
ENABLE_BUN=true
ENABLE_PYTHON=true
ENABLE_UV=true
ENABLE_PYRIGHT=true
ENABLE_AGENT_BROWSER=true
